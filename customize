# --- MODIFIER & FONTS ---
set $mod Mod4
font pango:Roboto Mono 9

# --- WINDOW GAPS & BORDERS ---
default_border pixel 2
default_floating_border pixel 2
gaps inner 12
gaps outer 8
smart_borders on

# --- MOUSE CONTROLS ---
# Hold Super + Left Click to drag, Right Click to resize
floating_modifier $mod
# Middle-click titlebar/border to close window
bindsym --release button2 kill

# --- KEYBINDINGS & WINDOW CONTROLS ---
bindsym $mod+Return exec alacritty
bindsym $mod+Shift+q kill
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+Shift+space floating_toggle
bindsym $mod+f fullscreen toggle

# Minimize / Restore (Scratchpad)
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Launch File Manager (Ranger)
bindsym $mod+r exec --no-startup-id alacritty -e ranger

# --- MANHATTAN / DARK BLUE COLOR SCHEME ---
set $bg           #1a1b26
set $surface      #24283b
set $text         #a9b1d6
set $accent       #7aa2f7
set $inactive     #414868

# Class                  Border    Backgrd   Text     Indicator Child Border
client.focused           $accent   $accent   $bg      $accent   $accent
client.unfocused         $inactive $surface  $text    $inactive $inactive
client.focused_inactive $inactive $surface  $text    $inactive $inactive
client.urgent            #f7768e   #f7768e   $bg      #f7768e   #f7768e

# --- AUTOSTART ---
exec_always --no-startup-id xcompmgr -c -C -t-5 -l-5 -r-42 -o.38
exec_always --no-startup-id ~/.config/polybar/launch.sh




[module/storage]
type = internal/fs
mount-0 = /
label-mounted = " %free%"
format-mounted-background = ${colors.pill-bg}
format-mounted-padding = 2

[module/uptime]
type = custom/script
exec = uptime -p | sed 's/up //'
interval = 60
format-prefix = " "
format-background = ${colors.pill-bg}
format-padding = 2

[module/date]
type = internal/date
interval = 1.0
date = "%a %d %b %H:%M"
format-prefix = " "
format-background = ${colors.pill-bg}
format-padding = 2

[module/temp]
type = internal/temperature
thermal-zone = 0
label = " %temperature-c%"
format-background = ${colors.pill-bg}
format-padding = 2

[module/battery]
